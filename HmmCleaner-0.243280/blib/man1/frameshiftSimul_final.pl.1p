.IX Title "FRAMESHIFTSIMUL_FINAL 1p"
.TH FRAMESHIFTSIMUL_FINAL 1p 2024-11-23 "perl v5.38.2" "User Contributed Perl Documentation"
.\" For nroff, turn off justification.  Always turn off hyphenation; it makes
.\" way too many mistakes in technical documents.
.if n .ad l
.nh
.SH NAME
frameshiftSimul_final.pl \- Simulation for HmmCleaner
.SH VERSION
.IX Header "VERSION"
version 0.243280
.SH USAGE
.IX Header "USAGE"
frameshiftSimul_final.pl <infiles> \-\-taxdir=<taxdir> [\-\-noX \-\-noStop \-nf <nf> \-sf <sf> \-rep <rep> \-\-profile=<profile>]
.SH "REQUIRED ARGUMENTS"
.IX Header "REQUIRED ARGUMENTS"
.IP <infiles> 4
.IX Item "<infiles>"
list of alignment file to check with HMMCleaner
.IP \-\-taxdir=<taxdir> 4
.IX Item "--taxdir=<taxdir>"
Path to local mirror of the NCBI Taxonomy database as obtain from setup\-taxdir.pl
.SH OPTIONS
.IX Header "OPTIONS"
.IP "\-t[hreshold] <threshold>" 4
.IX Item "-t[hreshold] <threshold>"
threshold value determining shifts in sequence compare to HMM model
.IP \-cost1=<cost1> 4
.IX Item "-cost1=<cost1>"
cost of blank character in profile alignment
.IP \-cost2=<cost2> 4
.IX Item "-cost2=<cost2>"
cost of + character in profile alignment
.IP \-cost3=<cost3> 4
.IX Item "-cost3=<cost3>"
cost of lowercase character in profile alignment
.IP \-cost4=<cost4> 4
.IX Item "-cost4=<cost4>"
cost of uppercase character in profile alignment
.IP "\-nf <nf>" 4
.IX Item "-nf <nf>"
number of frameshift
.IP "\-sf <sf>" 4
.IX Item "-sf <sf>"
size of frameshift
.IP "\-rep <rep>" 4
.IX Item "-rep <rep>"
number of replicate for one file
.IP "\-subset <subset>" 4
.IX Item "-subset <subset>"
number of seq to keep in file at random
.IP \-\-noX 4
.IX Item "--noX"
Determine that X characters don't have to be consider by HMMER
.IP \-\-noStop 4
.IX Item "--noStop"
Not stopping translation at STOP codon
.IP \-v[erbosity]=<level> 4
.IX Item "-v[erbosity]=<level>"
Verbosity level for logging to STDERR [default: 0]. Available levels range from
0 to 5.
.IP \-\-version 4
.IX Item "--version"
.PD 0
.IP \-\-usage 4
.IX Item "--usage"
.IP \-\-help 4
.IX Item "--help"
.IP \-\-man 4
.IX Item "--man"
.PD
Print the usual program information
